NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Login is now handled by Supabase Auth (see app/login/page.tsx and
# middleware.ts) instead of the old Basic Auth env vars — nothing extra
# to set here. Create your login user in the Supabase dashboard under
# Authentication > Users.

# Chart screenshots are uploaded to ImageKit (see app/api/screenshots)
# instead of Supabase Storage, to stay off Supabase's free-tier storage
# cap. Server-side only — never exposed to the browser. Find it in the
# ImageKit dashboard under Developer options > API keys > Private key.
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key

# Secret for the Vercel Cron job (see vercel.json) that pings Supabase
# every 3 days to stop the free-tier project auto-pausing after 7 days
# of inactivity. Set this to any random string — Vercel automatically
# sends it as a Bearer token when it triggers the cron job, and
# app/api/cron/keep-alive checks it matches before doing anything.
CRON_SECRET=your-random-secret-string

# Candlestick charts on the Trades page ("View chart" — see
# app/api/chart-data) are fetched from Twelve Data instead of the browser
# calling it directly, so this key never reaches the client. Get a free
# key at twelvedata.com (Basic/free plan: 800 calls/day, 8/min — plenty
# for opening a chart per trade). Some instruments (mainly certain stock
# exchanges) need a paid Twelve Data plan; the chart modal surfaces
# Twelve Data's own error message if a symbol isn't available on your plan.
TWELVE_DATA_API_KEY=your-twelve-data-api-key
